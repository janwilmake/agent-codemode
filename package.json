{
  "name": "agent-codemode",
  "version": "0.1.0",
  "description": "Let the scripts your coding agent writes call your MCP servers \u2014 no extra auth. Code mode for the agent you already run.",
  "keywords": [
    "codemode",
    "code-mode",
    "mcp",
    "model-context-protocol",
    "claude-code",
    "ai-agents",
    "agents",
    "cli",
    "typescript",
    "codegen"
  ],
  "license": "MIT",
  "author": "Jan Wilmake",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/janwilmake/agent-codemode.git"
  },
  "bugs": {
    "url": "https://github.com/janwilmake/agent-codemode/issues"
  },
  "homepage": "https://github.com/janwilmake/agent-codemode#readme",
  "type": "module",
  "bin": {
    "agent-codemode": "dist/cli.js",
    "codemode": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node test/smoke.mjs",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.23.12",
    "typescript": "^5.7.0"
  }
}
