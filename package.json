{
  "name": "claude-codemode",
  "version": "0.1.0",
  "description": "Call the MCP servers Claude Code is already authenticated to — from a script or from code. Adds tools/list and tools/call to what `claude mcp` can do.",
  "keywords": ["mcp", "claude-code", "cli", "codemode", "model-context-protocol"],
  "license": "MIT",
  "type": "module",
  "bin": {
    "claude-codemode": "dist/cli.js",
    "claude-mcp": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md"],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node test/smoke.mjs",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  }
}
